# ============================================================
# COMMANDFLOW AI — SERVER ENVIRONMENT CONFIGURATION
# Production Template for Render Deployment
# ============================================================

# Server Environment & Port (Render sets PORT dynamically)
PORT=5000
NODE_ENV=production

# Allowed Client Origin(s) (Comma-separated for web + Capacitor mobile)
CLIENT_URL=http://localhost:5173,capacitor://localhost,http://localhost

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/commandflow_ai?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_strong_random_jwt_secret_here_2026
JWT_EXPIRES_IN=30d

# Groq AI Engine
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# n8n Automation Engine (Deployed Render n8n HTTPS URL)
N8N_BASE_URL=https://your-n8n-service.onrender.com
N8N_WEBHOOK_SECRET=n8n_sec_commandflow_2026

# Google OAuth (For Google Sign-In & Gmail Integrations)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-service.onrender.com/api/integrations/gmail/callback

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_DEFAULT_CHAT_ID=your_telegram_chat_id

# Direct High-Speed Gmail SMTP Engine (App Password)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
DEFAULT_RECIPIENT_EMAIL=your_notification_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Redis (Optional on Render — runs direct fallback when Redis is absent)
# REDIS_URL=redis://default:<password>@red-xxxx:6379
