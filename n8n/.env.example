# ============================================================
# COMMANDFLOW AI — n8n RENDER ENVIRONMENT CONFIGURATION
# Production Template for Render Web Service (No Docker)
# ============================================================

# Port & Webhook Binding (Render dynamically sets PORT)
# N8N_PORT should be set to 10000 or $PORT in Render environment settings
N8N_PORT=10000
N8N_PROTOCOL=https

# Public Render HTTPS URL (Crucial for n8n Webhook Triggers)
WEBHOOK_URL=https://your-n8n-service.onrender.com/
N8N_HOST=your-n8n-service.onrender.com

# Backend Callback URL for Status Updates
BACKEND_URL=https://your-backend-service.onrender.com

# Security & Encryption Key (Must be set so workflow credentials remain decryptable across restarts)
N8N_ENCRYPTION_KEY=your_random_32_character_hex_encryption_key_here

# User folder location on Render
N8N_USER_FOLDER=/opt/render/project/src/.n8n

# Optional: PostgreSQL Database (Recommended for Free Tier Persistence to avoid losing workflows on restart)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=dpg-xxxx.render.com
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n_db
# DB_POSTGRESDB_USER=n8n_user
# DB_POSTGRESDB_PASSWORD=your_postgres_password
# DB_POSTGRESDB_SSL_CA=
