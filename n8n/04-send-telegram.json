      },
      "name": "Telegram Bot Node",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [350, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Telegram Bot Node",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
