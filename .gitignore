# ==========================================
# CommandFlow AI - Root .gitignore
# ==========================================

# ------------------------------
# Dependencies
# ------------------------------
node_modules/
**/node_modules/

# ------------------------------
# Build / Production
# ------------------------------
dist/
build/
.vite/
**/dist/
**/build/

# ------------------------------
# Environment / Secrets
# ------------------------------
.env
.env.*
!.env.example
!.env.example.*
!.env.production
**/.env
**/.env.*
!**/.env.example
!**/.env.production

# ------------------------------
# Logs
# ------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------
# Runtime / Temporary files
# ------------------------------
*.tmp
*.temp
.tmp/
temp/
cache/
*.pid
*.seed
__pycache__/
*.pyc
*.pyo

# ------------------------------
# Server uploads
# Keep the folder, ignore uploaded files
# ------------------------------
server/public/uploads/*
!server/public/uploads/.gitkeep

# ------------------------------
# Database / Local data
# ------------------------------
*.db
*.sqlite
*.sqlite3
*.rdb

# ------------------------------
# Coverage
# ------------------------------
coverage/
.nyc_output/

# ------------------------------
# OS generated files
# ------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------
# VS Code
# ------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ------------------------------
# IDE files
# ------------------------------
.idea/
*.iml

# ------------------------------
# Optional local configuration
# ------------------------------
*.local

# ------------------------------
# Vercel / Netlify
# ------------------------------
.vercel/
.netlify/

# ------------------------------
# N8N local data
# ------------------------------
.n8n/
n8n/.n8n/

# ------------------------------
# Generated files
# ------------------------------
*.generated.*