# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/commandflow_ai
# MONGO_DIRECT_URI=mongodb://user:password@shard-00-00.mongodb.net:27017,... (Optional direct replica-set URI)

# JWT Authentication Secret
JWT_SECRET=commandflow_ai_super_secret_jwt_key_2026

# Groq AI Engine Key
GROQ_API_KEY=your_groq_api_key_here

# n8n Orchestration Engine
